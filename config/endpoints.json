  "_speedTestReadme": "Cloudflare rate-limits by data volume per public IP, and behind the proxy every VM shares that IP, so each run is capped. To use an approved internal target instead, point downloadUrl at any large file (GET) and uploadUrl at anything that accepts a POST; leave uploadUrl empty to skip upload.",
  "speedTest": {
    "enabled": true,
    "provider": "Cloudflare",
    "latencyUrl": "https://speed.cloudflare.com/__down?bytes=0",
    "downloadUrl": "https://speed.cloudflare.com/__down?bytes=25000000",
    "uploadUrl": "https://speed.cloudflare.com/__up",
    "uploadChunkBytes": 2000000,
    "seconds": 6,
    "streams": 4,
    "maxDownloadMB": 150,
    "maxUploadMB": 40
  },

  "_publicIssuersReadme": "Certificate issuer organisations treated as public CAs. Anything else on an HTTPS check is reported as TLS inspection (for example, a proxy re-signing traffic).",
