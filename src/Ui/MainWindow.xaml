<!--
  AVD Health Check main window. Loaded at runtime with XamlReader (no x:Class),
  so there are no event handlers here: MainController finds elements by x:Name.
  Palette matches Incident Lab: Lloyds black, carbon surfaces, Grove green #006a4d.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AVD Health Check"
        Width="1240" Height="840" MinWidth="1080" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="#000000"
        Foreground="#F5F5F5"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

  <Window.Resources>
    <SolidColorBrush x:Key="Surface" Color="#0C0C0C"/>
    <SolidColorBrush x:Key="SurfaceAlt" Color="#141414"/>
    <SolidColorBrush x:Key="Line" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="LineSoft" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="LineStrong" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="Ink" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="Muted" Color="#B5B5B5"/>
    <SolidColorBrush x:Key="Subtle" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="Accent" Color="#006A4D"/>
    <SolidColorBrush x:Key="AccentHover" Color="#1B8F5F"/>
    <SolidColorBrush x:Key="AccentText" Color="#3DBE8A"/>
    <SolidColorBrush x:Key="Warn" Color="#E6C27A"/>
    <SolidColorBrush x:Key="Fail" Color="#F0857C"/>
    <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <!-- Small pill toggle ("Show issues only") -->
    <Style x:Key="PillToggle" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Background" Value="{StaticResource SurfaceAlt}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="12,7">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="Dot" Width="7" Height="7" Fill="#E6C27A" Margin="0,0,7,0" VerticalAlignment="Center"/>
                <ContentPresenter VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentText}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#2A2418"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#E6C27A"/>
                <Setter Property="Foreground" Value="#E6C27A"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#006A4D" Offset="0"/>
      <GradientStop Color="#3DBE8A" Offset="1"/>
    </LinearGradientBrush>

    <!-- Cards -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="16"/>
    </Style>

    <Style x:Key="CardLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Subtle}"/>
    </Style>

    <Style x:Key="CardValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="26"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Margin" Value="0,6,0,2"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Green / amber / red value for the Prisma and Teams cards. Tag carries the CheckState. -->
    <Style x:Key="StatusValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="26"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{StaticResource Subtle}"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Pass">
          <Setter Property="Foreground" Value="#3DBE8A"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Warn">
          <Setter Property="Foreground" Value="#E6C27A"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Fail">
          <Setter Property="Foreground" Value="#F0857C"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="StatusDot" TargetType="Ellipse">
      <Setter Property="Width" Value="11"/>
      <Setter Property="Height" Value="11"/>
      <Setter Property="Margin" Value="0,3,10,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Fill" Value="#3A3A3A"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Pass">
          <Setter Property="Fill" Value="#3DBE8A"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Warn">
          <Setter Property="Fill" Value="#E6C27A"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Fail">
          <Setter Property="Fill" Value="#F0857C"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Running">
          <DataTrigger.EnterActions>
            <BeginStoryboard x:Name="DotPulse">
              <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.6"/>
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.EnterActions>
          <DataTrigger.ExitActions>
            <RemoveStoryboard BeginStoryboardName="DotPulse"/>
          </DataTrigger.ExitActions>
          <Setter Property="Fill" Value="#3DBE8A"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Up to two lines; the full text is in the tooltip and the copied report. -->
    <Style x:Key="CardSub" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="MaxHeight" Value="34"/>
      <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>

    <!-- Buttons -->
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHover}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentText}"/>
                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Background" Value="{StaticResource SurfaceAlt}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentText}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentText}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Read-only, selectable value text (so single values can be copied too) -->
    <Style x:Key="ValueBox" TargetType="TextBox">
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="SelectionBrush" Value="{StaticResource AccentText}"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Slim scroll bar -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="MinWidth" Value="10"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border x:Name="T" Background="#2E2E2E" CornerRadius="4" Margin="3,2"/>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="T" Property="Background" Value="#4A4A4A"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Thin progress bar under the header -->
    <Style x:Key="ThinProgress" TargetType="ProgressBar">
      <Setter Property="Height" Value="3"/>
      <Setter Property="Maximum" Value="100"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" Background="#161616" CornerRadius="2"/>
              <Border x:Name="PART_Indicator" Background="{StaticResource AccentGradient}" CornerRadius="2" HorizontalAlignment="Left"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- One endpoint row -->
    <DataTemplate x:Key="CheckRow">
      <Border Padding="6,10,6,10" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="32"/>
            <ColumnDefinition Width="5*" MinWidth="190"/>
            <ColumnDefinition Width="7*"/>
            <ColumnDefinition Width="72"/>
          </Grid.ColumnDefinitions>

          <Grid Width="18" Height="18" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,1,0,0">
            <Ellipse x:Name="Ring" Stroke="#3A3A3A" StrokeThickness="1.5"/>
            <Grid x:Name="Spinner" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform>
                <RotateTransform Angle="0"/>
              </Grid.RenderTransform>
              <Ellipse Stroke="#16352A" StrokeThickness="2"/>
              <Path Stroke="#3DBE8A" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M9,1 A8,8 0 0 1 17,9"/>
            </Grid>
            <Grid x:Name="PassIcon" Visibility="Collapsed">
              <Ellipse Fill="#0F2A1F"/>
              <Path Data="M5.2,9.3 L7.9,12 L12.9,6.6" Stroke="#3DBE8A" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Grid>
            <Grid x:Name="WarnIcon" Visibility="Collapsed">
              <Ellipse Fill="#2A2418"/>
              <Path Data="M9,4.8 L9,10.2 M9,13.1 L9,13.2" Stroke="#E6C27A" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Grid>
            <Grid x:Name="FailIcon" Visibility="Collapsed">
              <Ellipse Fill="#2E1715"/>
              <Path Data="M6.2,6.2 L11.8,11.8 M11.8,6.2 L6.2,11.8" Stroke="#F0857C" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Grid>
          </Grid>

          <StackPanel Grid.Column="1" Margin="0,0,18,0">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Target}" FontFamily="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Subtle}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
          </StackPanel>

          <TextBlock x:Name="DetailText" Grid.Column="2" Text="{Binding Detail}" TextWrapping="Wrap" FontSize="12"
                     Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>

          <TextBlock Grid.Column="3" Text="{Binding Latency}" HorizontalAlignment="Right" VerticalAlignment="Center"
                     FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource Muted}"/>
        </Grid>
      </Border>

      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding State}" Value="Running">
          <Setter TargetName="Ring" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="Spinner" Property="Visibility" Value="Visible"/>
          <Setter TargetName="DetailText" Property="Foreground" Value="{StaticResource Subtle}"/>
          <DataTrigger.EnterActions>
            <BeginStoryboard x:Name="Spin">
              <Storyboard RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetName="Spinner"
                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                 From="0" To="360" Duration="0:0:0.8"/>
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.EnterActions>
          <DataTrigger.ExitActions>
            <RemoveStoryboard BeginStoryboardName="Spin"/>
          </DataTrigger.ExitActions>
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Pending">
          <Setter TargetName="DetailText" Property="Foreground" Value="{StaticResource Subtle}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Pass">
          <Setter TargetName="Ring" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="PassIcon" Property="Visibility" Value="Visible"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Warn">
          <Setter TargetName="Ring" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="WarnIcon" Property="Visibility" Value="Visible"/>
          <Setter TargetName="DetailText" Property="Foreground" Value="{StaticResource Warn}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Fail">
          <Setter TargetName="Ring" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="FailIcon" Property="Visibility" Value="Visible"/>
          <Setter TargetName="DetailText" Property="Foreground" Value="#F0B4AE"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Grid ClipToBounds="True">
    <!-- Lloyds-style organic bands behind everything (same shapes as Incident Lab) -->
    <Viewbox Stretch="UniformToFill" IsHitTestVisible="False">
      <Canvas Width="1600" Height="900">
        <Ellipse Canvas.Left="-640" Canvas.Top="-620" Width="1520" Height="1200" Fill="#111111"/>
        <Ellipse Canvas.Left="-640" Canvas.Top="290" Width="1160" Height="860" Fill="#141414"/>
        <Ellipse Canvas.Left="780" Canvas.Top="340" Width="1800" Height="1280" Fill="#0F0F0F"/>
      </Canvas>
    </Viewbox>

    <Grid Margin="30,24,30,18">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- ===== Header ===== -->
      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border Width="50" Height="50" CornerRadius="13" Background="#FFFFFF" Padding="7" VerticalAlignment="Center">
          <Border.Effect>
            <DropShadowEffect Color="#006A4D" BlurRadius="26" ShadowDepth="0" Opacity="0.55"/>
          </Border.Effect>
          <Viewbox Stretch="Uniform">
            <Canvas Width="130" Height="102">
              <Path x:Name="HorseGrey" Fill="#6D6E70">
                <Path.RenderTransform><TranslateTransform X="-328" Y="-4"/></Path.RenderTransform>
              </Path>
              <Path x:Name="HorseDark" Fill="#231F20">
                <Path.RenderTransform><TranslateTransform X="-328" Y="-4"/></Path.RenderTransform>
              </Path>
            </Canvas>
          </Viewbox>
        </Border>

        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="AVD Health Check" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
          <TextBlock Text="Lloyds Banking Group · Virtual Team" FontSize="12" Foreground="{StaticResource Subtle}" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Overall status pill -->
        <Border Grid.Column="2" CornerRadius="10" Padding="14,0" Height="40" Margin="0,0,10,0" VerticalAlignment="Center" BorderThickness="1">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background" Value="#102117"/>
              <Setter Property="BorderBrush" Value="#16352A"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding OverallState}" Value="Warn">
                  <Setter Property="Background" Value="#2A2418"/>
                  <Setter Property="BorderBrush" Value="#4A3F26"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding OverallState}" Value="Fail">
                  <Setter Property="Background" Value="#2A1816"/>
                  <Setter Property="BorderBrush" Value="#4D2925"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
              <Ellipse.Style>
                <Style TargetType="Ellipse">
                  <Setter Property="Fill" Value="#3DBE8A"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding OverallState}" Value="Warn">
                      <Setter Property="Fill" Value="#E6C27A"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding OverallState}" Value="Fail">
                      <Setter Property="Fill" Value="#F0857C"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding OverallState}" Value="Running">
                      <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Pulse">
                          <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.7"/>
                          </Storyboard>
                        </BeginStoryboard>
                      </DataTrigger.EnterActions>
                      <DataTrigger.ExitActions>
                        <RemoveStoryboard BeginStoryboardName="Pulse"/>
                      </DataTrigger.ExitActions>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Ellipse.Style>
            </Ellipse>
            <TextBlock Text="{Binding OverallText}" FontWeight="SemiBold" FontSize="12.5">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="#9EE0C4"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding OverallState}" Value="Warn">
                      <Setter Property="Foreground" Value="#E6C27A"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding OverallState}" Value="Fail">
                      <Setter Property="Foreground" Value="#F0B4AE"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Border>

        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="RunButton" Style="{StaticResource SecondaryButton}" IsEnabled="{Binding IsIdle}" Margin="0,0,10,0" ToolTip="Run every check again (F5)">
            <StackPanel Orientation="Horizontal">
              <Path Data="M13.5,4.5 A6,6 0 1 0 14.5,9.5 M13.5,1.5 L13.5,4.8 L10.2,4.8" Stroke="{StaticResource Ink}" StrokeThickness="1.6"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
              <TextBlock Text="Run again" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="CopyButton" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding IsIdle}" ToolTip="Copy the full report for a ServiceNow incident (Ctrl+C)">
            <StackPanel Orientation="Horizontal">
              <Path Data="M5.5,5.5 L5.5,2.5 L13.5,2.5 L13.5,10.5 L10.5,10.5 M2.5,5.5 L10.5,5.5 L10.5,13.5 L2.5,13.5 Z" Stroke="#FFFFFF" StrokeThickness="1.5"
                    StrokeLineJoin="Round" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding CopyLabel}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <!-- ===== Progress ===== -->
      <ProgressBar Grid.Row="1" Style="{StaticResource ThinProgress}" Value="{Binding Progress}" Margin="0,20,0,18"/>

      <!-- ===== Summary cards ===== -->
      <UniformGrid Grid.Row="2" Columns="5" Margin="-6,0,-6,16">
        <Border Style="{StaticResource Card}" Margin="6,0" Padding="20,16">
          <StackPanel>
            <TextBlock Text="CONNECTIVITY" Style="{StaticResource CardLabel}"/>
            <TextBlock Text="{Binding ConnValue}" Style="{StaticResource CardValue}"/>
            <TextBlock Text="{Binding ConnSub}" Style="{StaticResource CardSub}"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="6,0" Padding="20,16">
          <StackPanel>
            <TextBlock Text="PRISMA ACCESS" Style="{StaticResource CardLabel}"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
              <Ellipse Style="{StaticResource StatusDot}" Tag="{Binding PrismaState}"/>
              <TextBlock Text="{Binding PrismaValue}" Style="{StaticResource StatusValue}" Tag="{Binding PrismaState}"/>
            </StackPanel>
            <TextBlock Text="{Binding PrismaSub}" Style="{StaticResource CardSub}"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="6,0" Padding="20,16">
          <StackPanel>
            <TextBlock Text="TEAMS MEDIA" Style="{StaticResource CardLabel}"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
              <Ellipse Style="{StaticResource StatusDot}" Tag="{Binding TeamsState}"/>
              <TextBlock Text="{Binding TeamsValue}" Style="{StaticResource StatusValue}" Tag="{Binding TeamsState}"/>
            </StackPanel>
            <TextBlock Text="{Binding TeamsSub}" Style="{StaticResource CardSub}"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="6,0" Padding="20,16">
          <StackPanel>
            <TextBlock Text="SPEED  ↓ DOWN / ↑ UP" Style="{StaticResource CardLabel}"/>
            <TextBlock Style="{StaticResource CardValue}">
              <Run Text="{Binding DownValue, Mode=OneWay}"/><Run Text=" / " Foreground="#5C5C5C" FontWeight="Normal"/><Run Text="{Binding UpValue, Mode=OneWay}"/><Run Text=" Mbps" FontSize="13" FontWeight="SemiBold" Foreground="#8A8A8A"/>
            </TextBlock>
            <TextBlock Text="{Binding SpeedSub}" Style="{StaticResource CardSub}"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="6,0" Padding="20,16">
          <StackPanel>
            <TextBlock Text="LATENCY" Style="{StaticResource CardLabel}"/>
            <TextBlock Style="{StaticResource CardValue}">
              <Run Text="{Binding LatValue, Mode=OneWay}"/><Run Text=" ms" FontSize="13" FontWeight="SemiBold" Foreground="#8A8A8A"/>
            </TextBlock>
            <TextBlock Text="{Binding LatSub}" Style="{StaticResource CardSub}"/>
          </StackPanel>
        </Border>
      </UniformGrid>

      <!-- ===== Device + connectivity ===== -->
      <Grid Grid.Row="3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="390"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" Padding="22,18,10,10">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,12,10">
              <TextBlock Text="This device" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="Read locally on this machine" FontSize="12" Foreground="{StaticResource Subtle}" Margin="0,2,0,0"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Device}" Margin="0,0,12,0" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" Padding="0,9">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="132"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{StaticResource Subtle}" Margin="0,1,10,0"/>
                        <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" Style="{StaticResource ValueBox}" FontSize="12.5"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22,18,10,10">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,12,4">
              <StackPanel Margin="0,0,200,0">
                <TextBlock Text="Checks" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Client app, Prisma and Teams first, then each endpoint through the system proxy" FontSize="12" Foreground="{StaticResource Subtle}"
                           Margin="0,2,0,0" TextWrapping="Wrap"/>
              </StackPanel>
              <ToggleButton x:Name="IssuesToggle" Style="{StaticResource PillToggle}" Content="{Binding IssuesLabel}"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Visibility="{Binding HasIssues, Converter={StaticResource BoolToVis}}"
                            ToolTip="Hide the endpoints that passed"/>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding ChecksView}" ItemTemplate="{StaticResource CheckRow}" Margin="0,0,12,0" Focusable="False">
                <ItemsControl.GroupStyle>
                  <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="6,16,0,4">
                          <Rectangle Width="14" Height="2" RadiusX="1" RadiusY="1" Fill="#3DBE8A" VerticalAlignment="Center" Margin="0,0,9,0"/>
                          <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold" Foreground="#3DBE8A"/>
                          <TextBlock Text="{Binding ItemCount}" FontSize="12" Foreground="#5C5C5C" Margin="8,0,0,0"/>
                        </StackPanel>
                      </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                  </GroupStyle>
                </ItemsControl.GroupStyle>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>

      <!-- ===== Footer ===== -->
      <Grid Grid.Row="4" Margin="2,14,2,0">
        <TextBlock Text="{Binding Footer}" FontSize="11.5" Foreground="{StaticResource Subtle}" TextTrimming="CharacterEllipsis" Margin="0,0,320,0"/>
        <TextBlock HorizontalAlignment="Right" FontSize="11.5" Foreground="#5C5C5C"
                   Text="Results stay on this machine until you copy them."/>
      </Grid>
    </Grid>
  </Grid>
</Window>
